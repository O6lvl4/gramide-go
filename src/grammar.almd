// lang_go — the Go grammar, as a value.
//
// Written against the Go language specification. Node kinds that matter to
// `tags` and `outline` share names with the Almide grammar
// (function_declaration, method_declaration, type_declaration, arguments,
// field_access, type_name) so the same walkers serve both languages.
//
// The lexer has already applied semicolon insertion, so a `newline` token
// is a statement separator and nothing else; the grammar never needs `nl`.
//
// The one place Go's grammar depends on context is the composite literal:
// `T{…}` is an expression everywhere except in the header of `if`, `for`
// and `switch`, where `if x == T{}` would swallow the block. The expression
// rules are therefore generated twice from one function — once allowing a
// trailing `{`, once (suffix `_nc`) not — which is the kind of thing a
// grammar that is a value can do in five lines.

import gramide.names as nametable
import gramide.lex
import gramide.tree
import gramide.parser
import gramide.parser.{ tok, lit, keep, r, seq, alt, rep, rep1, opt, wrap, field, ahead, leftf, lits, keeps, grammar, recover, recover_all, recover_all_keeping }
import self.lexer

let ident = tok("identifier")
let sep = rep1(alt([lit(";"), tok("newline")]))
let osep = opt(sep)

fn items(x: parser.Rule) -> parser.Rule = opt(seq([x, rep(seq([lit(","), x])), opt(lit(","))]))
fn bracketed(open: String, x: parser.Rule, close: String) -> parser.Rule = seq([lit(open), items(x), lit(close)])
fn grouped(one: parser.Rule) -> parser.Rule =
  alt([seq([lit("("), osep, rep(seq([one, osep])), lit(")")]), one])

let ty = r("type")
let block = r("block")
let stmt = r("stmt")

// ── expressions, generated for a suffix ──────────────────────────────────
fn expr_rules(sfx: String, composite: Bool) -> List[(String, parser.Rule)] = {
  let postfix_ops = [
    wrap("arguments", seq([lit("("), items(seq([r("expr"), opt(lit("..."))])), lit(")")])),
    wrap("type_assertion", seq([lit("."), lit("("), alt([lit("type"), ty]), lit(")")])),
    wrap("field_access", seq([lit("."), field("field", ident)])),
    wrap("index", seq([lit("["), items(seq([opt(r("expr")), opt(seq([lit(":"), opt(r("expr")), opt(seq([lit(":"), r("expr")]))]))])), lit("]")])),
  ]
  let ops = if composite then postfix_ops + [r("literal_body")] else postfix_ops
  // Only the bare-type-name form of a composite literal is ambiguous in a
  // statement header; `[]T{…}`, `struct{…}{…}`, `map[K]V{…}` are always
  // allowed, so a type operand may take its literal body in both variants.
  let operand = alt([
    tok("integer"), tok("float"), tok("imaginary"), tok("string"), tok("rune"),
    wrap("function_literal", seq([lit("func"), r("signature"), block])),
    wrap("group", seq([lit("("), r("expr"), lit(")")])),
    seq([r("type_operand"), opt(r("literal_body"))]),
    ident])
  [
    ("expr" + sfx, leftf("binary", r("and" + sfx), keep("||"))),
    ("and" + sfx, leftf("binary", r("cmp" + sfx), keep("&&"))),
    ("cmp" + sfx, leftf("binary", r("sum" + sfx), keeps(["==", "!=", "<=", ">=", "<", ">"]))),
    ("sum" + sfx, leftf("binary", r("product" + sfx), keeps(["+", "-", "|", "^"]))),
    ("product" + sfx, leftf("binary", r("unary" + sfx), keeps(["*", "/", "%", "<<", ">>", "&^", "&"]))),
    ("unary" + sfx, alt([
       wrap("unary", seq([field("operator", keeps(["+", "-", "!", "^", "*", "&", "<-", "~"])), r("unary" + sfx)])),
       r("postfix" + sfx)])),
    ("postfix" + sfx, seq([operand, rep(alt(ops))])),
  ]
}

fn rules() -> parser.Grammar = grammar("source_file", [
  ("source_file", wrap("source_file", seq([osep, r("package"), sep, rep(seq([r("import"), sep])), rep(recover_all_keeping(seq([r("top_decl"), osep]), r("decl_head")))]))),
  ("package", wrap("package_clause", seq([lit("package"), field("name", ident)]))),
  ("import", wrap("import", seq([lit("import"), grouped(r("import_spec"))]))),
  ("import_spec", wrap("import_spec", seq([opt(alt([ident, lit(".")])), field("path", tok("string"))]))),

  ("top_decl", alt([r("func_decl"), r("decl")])),
  // what is still worth knowing about a declaration whose body or signature
  // is half-typed: its kind and its name
  ("decl_head", alt([
     wrap("method_declaration", seq([lit("func"), lit("("), ident, opt(lit("*")), ident, lit(")"), field("name", ident)])),
     wrap("function_declaration", seq([lit("func"), field("name", ident)])),
     wrap("type_declaration", seq([lit("type"), wrap("type_spec", field("name", ident))])),
     wrap("var_declaration", seq([lit("var"), wrap("var_spec", field("name", ident))])),
     wrap("const_declaration", seq([lit("const"), wrap("const_spec", field("name", ident))]))])),
  ("decl", alt([r("var_decl"), r("const_decl"), r("type_decl")])),
  ("var_decl", wrap("var_declaration", seq([lit("var"), grouped(r("var_spec"))]))),
  ("var_spec", wrap("var_spec", seq([field("name", ident), rep(seq([lit(","), ident])),
     alt([seq([ty, opt(seq([lit("="), r("expr_list")]))]), seq([lit("="), r("expr_list")])])]))),
  ("const_decl", wrap("const_declaration", seq([lit("const"), grouped(r("const_spec"))]))),
  ("const_spec", wrap("const_spec", seq([field("name", ident), rep(seq([lit(","), ident])),
     opt(alt([seq([opt(ty), lit("="), r("expr_list")]), ty]))]))),
  ("type_decl", wrap("type_declaration", seq([lit("type"), grouped(r("type_spec"))]))),
  ("type_spec", wrap("type_spec", seq([field("name", ident), opt(r("type_params")), opt(lit("=")), field("type", ty)]))),
  ("type_params", seq([lit("["), items(seq([ident, rep(seq([lit(","), ident])), r("constraint")])), lit("]")])),
  ("constraint", seq([opt(lit("~")), ty, rep(seq([lit("|"), opt(lit("~")), ty]))])),

  ("func_decl", alt([
     wrap("method_declaration", seq([lit("func"), field("receiver", r("parameters")), field("name", ident), opt(r("type_params")), r("signature"), opt(block)])),
     wrap("function_declaration", seq([lit("func"), field("name", ident), opt(r("type_params")), r("signature"), opt(block)]))])),
  ("signature", seq([r("parameters"), opt(r("result"))])),
  ("result", alt([r("parameters"), ty])),
  ("parameters", wrap("parameters", seq([lit("("), items(r("param")), lit(")")]))),
  // `a, b int`, `int`, `xs ...int`: a lone name parses as a type, which is
  // right for `(int, string)` and harmless for `(a, b int)`
  ("param", wrap("parameter", alt([seq([field("name", ident), opt(lit("...")), field("type", ty)]), seq([opt(lit("...")), field("type", ty)])]))),

  // ── types ─────────────────────────────────────────────────────────────
  ("type", alt([
     seq([lit("("), ty, lit(")")]),
     wrap("pointer_type", seq([lit("*"), ty])),
     wrap("slice_type", seq([lit("["), lit("]"), ty])),
     wrap("array_type", seq([lit("["), alt([lit("..."), r("expr")]), lit("]"), ty])),
     wrap("map_type", seq([lit("map"), lit("["), ty, lit("]"), ty])),
     wrap("channel_type", seq([alt([seq([lit("chan"), opt(lit("<-"))]), seq([lit("<-"), lit("chan")])]), ty])),
     wrap("function_type", seq([lit("func"), r("signature")])),
     r("struct_type"), r("interface_type"),
     wrap("type_name", seq([ident, opt(seq([lit("."), ident])), opt(r("type_args"))]))])),
  ("type_args", seq([lit("["), items(ty), lit("]")])),
  ("struct_type", wrap("struct_type", seq([lit("struct"), lit("{"), osep, rep(seq([r("field_decl"), osep])), lit("}")]))),
  ("field_decl", wrap("field", alt([
     seq([field("name", ident), rep(seq([lit(","), ident])), field("type", ty), opt(tok("string"))]),
     seq([opt(lit("*")), field("type", r("type")), opt(tok("string"))])]))),
  ("interface_type", wrap("interface_type", seq([lit("interface"), lit("{"), osep, rep(seq([r("interface_elem"), osep])), lit("}")]))),
  ("interface_elem", alt([wrap("method_signature", seq([field("name", ident), r("signature")])), r("constraint")])),

  // ── statements ────────────────────────────────────────────────────────
  ("block", wrap("block", seq([lit("{"), osep, rep(recover(seq([stmt, osep]))), lit("}")]))),
  ("stmt", alt([
     r("decl"),
     wrap("labeled", seq([ident, lit(":"), opt(stmt)])),
     wrap("go", seq([lit("go"), r("expr")])),
     wrap("defer", seq([lit("defer"), r("expr")])),
     wrap("return", seq([lit("return"), opt(r("expr_list"))])),
     wrap("break", seq([lit("break"), opt(ident)])),
     wrap("continue", seq([lit("continue"), opt(ident)])),
     wrap("goto", seq([lit("goto"), ident])),
     wrap("fallthrough", lit("fallthrough")),
     r("if"), r("for"), r("switch"), r("select"),
     block,
     r("simple_stmt")])),
  ("expr_list", seq([r("expr"), rep(seq([lit(","), r("expr")]))])),
  ("expr_list_nc", seq([r("expr_nc"), rep(seq([lit(","), r("expr_nc")]))])),
  ("simple_stmt", r("simple")),
  ("simple_stmt_nc", r("simple_nc")),
  ("simple", seq([r("expr_list"), opt(alt([
     wrap("assignment", seq([lits(["=", ":=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>=", "&^="]), r("expr_list")])),
     wrap("inc_dec", lits(["++", "--"])),
     wrap("send", seq([lit("<-"), r("expr")]))]))])),
  ("simple_nc", seq([r("expr_list_nc"), opt(alt([
     wrap("assignment", seq([lits(["=", ":=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>=", "&^="]), r("expr_list_nc")])),
     wrap("inc_dec", lits(["++", "--"])),
     wrap("send", seq([lit("<-"), r("expr_nc")]))]))])),

  ("if", wrap("if", seq([lit("if"), opt(seq([r("simple_stmt_nc"), lit(";")])), field("condition", r("expr_nc")), block,
     opt(seq([lit("else"), alt([r("if"), block])]))]))),
  ("for", wrap("for", seq([lit("for"), opt(alt([
     seq([opt(seq([r("expr_list_nc"), lits([":=", "="])])), lit("range"), r("expr_nc")]),
     seq([opt(r("simple_stmt_nc")), lit(";"), opt(r("expr_nc")), lit(";"), opt(r("simple_stmt_nc"))]),
     r("expr_nc")])), block]))),
  ("switch", wrap("switch", seq([lit("switch"), opt(seq([r("simple_stmt_nc"), lit(";")])), opt(r("simple_stmt_nc")),
     lit("{"), osep, rep(seq([r("case_clause"), osep])), lit("}")]))),
  // a switch case lists expressions; a select case is a send or a receive
  // statement (`case v, ok := <-c:`), which simple_stmt covers
  ("case_clause", wrap("case", seq([alt([seq([lit("case"), r("simple_stmt")]), lit("default")]), lit(":"), osep, rep(seq([stmt, osep]))]))),
  ("select", wrap("select", seq([lit("select"), lit("{"), osep, rep(seq([r("case_clause"), osep])), lit("}")]))),

  // ── operands ──────────────────────────────────────────────────────────
  // a type in expression position: conversions `[]byte(s)`, `make(map[K]V)`,
  // composite literals `[]int{1, 2}`, type switch cases
  ("type_operand", alt([
     wrap("slice_type", seq([lit("["), lit("]"), ty])),
     wrap("array_type", seq([lit("["), alt([lit("..."), r("expr")]), lit("]"), ty])),
     wrap("map_type", seq([lit("map"), lit("["), ty, lit("]"), ty])),
     wrap("channel_type", seq([alt([seq([lit("chan"), opt(lit("<-"))]), seq([lit("<-"), lit("chan")])]), ty])),
     wrap("function_type", seq([lit("func"), r("signature")])),
     r("struct_type"), r("interface_type")])),
  ("literal_body", wrap("literal", seq([lit("{"), osep, items(seq([r("element"), osep])), lit("}")]))),
  ("element", seq([r("element_value"), opt(seq([lit(":"), r("element_value")]))])),
  ("element_value", alt([r("literal_body"), r("expr")])),
] + expr_rules("", true) + expr_rules("_nc", false))

// ── tests ──────────────────────────────────────────────────────────────
fn parse_src(src: String) -> Result[parser.Parsed, String] = {
  let toks = lex.tokenize(src, lexer.spec()) |> result.map_err((e) => "lex " + int.to_string(e.line) + ":" + int.to_string(e.col) + " " + e.message)!
  parser.parse(rules(), bytes.from_string(src), toks) |> result.map_err((f) => parser.format_failure(f))
}

fn top_kinds(src: String) -> List[String] = match parse_src(src) {
  ok(p) => list.map(p.root.kids, (k) => nametable.name_at(p.names, k.kind)),
  err(e) => ["ERROR " + e],
}

// what a reader gets from a file that does not parse
fn recovered_kinds(src: String) -> List[String] = {
  let toks = lex.tokenize_recovering(src, lexer.spec())
  match parser.parse_recovering(parser.compile(rules()), bytes.from_string(src), toks) {
    ok(p) => list.map(p.root.kids, (k) => nametable.name_at(p.names, k.kind)),
    err(_) => ["NOTHING"],
  }
}

test "a small program parses with the right declaration kinds" {
  let src = """
package main

import (
	"fmt"
	str "strings"
)

type Point struct {
	X, Y int
	tag  string `json:"tag"`
}

type Shape interface {
	Area() float64
}

const N = 3

var xs = []int{1, 2, 3}

func (p *Point) Move(dx int) { p.X += dx }

func Map[T any, U any](xs []T, f func(T) U) []U {
	out := make([]U, 0, len(xs))
	for i, x := range xs {
		if x == xs[i] && i < N {
			out = append(out, f(x))
		} else if p := (Point{X: 1}); p.X > 0 {
			continue
		}
	}
	switch v := any(xs).(type) {
	case []int, nil:
		fmt.Println(v, str.ToUpper("a"))
	default:
	}
	go func() { defer fmt.Println("done") }()
	m := map[string][]int{"a": {1}, "b": nil}
	ch := make(chan<- int)
	ch <- m["a"][0]
	return out
}
"""
  assert_eq(top_kinds(src), ["package_clause", "import", "type_declaration", "type_declaration", "const_declaration", "var_declaration", "method_declaration", "function_declaration"])
}

test "a composite literal in an if header does not swallow the block" {
  match parse_src("package p\nfunc f() { if x == T{X: 1, Y: 2} { return } }\n") {
    ok(_) => assert(false),
    err(e) => assert(string.starts_with(e, "2:")),
  }
  assert_eq(top_kinds("package p\nfunc f() { if x == (T{X: 1, Y: 2}) { return } }\n"), ["package_clause", "function_declaration"])
}

test "a broken statement loses its statement, not the file" {
  let src = "package p\n\nfunc Alpha() int {\n\treturn 1\n}\n\nfunc Beta() int {\n\tz := 1 *\n\treturn z\n}\n\nfunc Gamma() int {\n\treturn 3\n}\n"
  // strict is unchanged: this file does not parse
  match parse_src(src) { ok(_) => assert(false), err(e) => assert(string.starts_with(e, "9:")) }
  // recovering keeps all three declarations
  assert_eq(recovered_kinds(src), ["package_clause", "function_declaration", "function_declaration", "function_declaration"])
}

test "a broken declaration becomes an ERROR node and the rest survives" {
  let src = "package p\n\nfunc Alpha() int { return 1 }\n\nfunc ) Beta( {\n\nfunc Gamma() int { return 3 }\n"
  assert_eq(list.contains(recovered_kinds(src), "ERROR"), true)
  assert_eq(list.contains(recovered_kinds(src), "function_declaration"), true)
}

test "an unterminated string still gives up only the line it is on" {
  let src = "package p\n\nfunc Alpha() string {\n\treturn \"hello\n}\n\nfunc Beta() int {\n\treturn 2\n}\n"
  // the lexer alone rejects it
  assert_eq(result.is_err(lex.tokenize(src, lexer.spec())), true)
  assert_eq(recovered_kinds(src), ["package_clause", "function_declaration", "function_declaration"])
}

test "a file that parses recovers to exactly the same tree" {
  let src = "package p\n\nfunc Alpha() int { return 1 }\n"
  assert_eq(recovered_kinds(src), top_kinds(src))
}
