// symbols — which of this grammar's nodes declare a name, which own methods,
// and which reference one: the rules the readers in gramide walk with.
// The tests are what those readers then say about a small Go file.
import gramide.package_api
import gramide.lex
import gramide.parser
import gramide.tags
import self.lexer
import self.grammar

fn symbol_rules() -> package_api.SymbolRules = package_api.SymbolRules {
  declarations: [("function_declaration", "function"), ("method_declaration", "method"), ("method_signature", "method"), ("type_declaration", "type"), ("type_spec", "type"), ("var_spec", "var"), ("const_spec", "const"), ("field", "field")],
  scopes: ["type_spec", "type_declaration"], namespaces: [], callables: ["function_declaration", "method_declaration", "method_signature"],
  lexical_owners: false, envelopes: [], unnamed_envelopes: [],
  arguments: "arguments", field_access: "field_access", type_mentions: ["type_name"]
}

test "a Go method is named with its receiver, which is not where it is written" {
  let src = "package p\n\ntype Shape struct{ w int }\n\nfunc (s *Shape) Area() int { return s.w }\n"
  let source = bytes.from_string(src)
  let toks = lex.tokenize(src, lexer.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(grammar.rules(), source, toks) |> result.map_err((f) => parser.format_failure(f))!
  assert(list.contains(tags.outline(p.root, toks, source, p.names, ".", symbol_rules()), "L5-5 method Shape.Area"))
}
